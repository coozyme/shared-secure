{
  "name": "shared-secure",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "pnpm --filter @shared/web build && pnpm --parallel --filter @shared/web --filter @shared/worker dev",
    "build": "pnpm --filter @shared/web build && pnpm --filter @shared/worker build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "pnpm -r test",
    "test:headers": "node scripts/smoke-headers.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level high",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test && pnpm test:headers && pnpm test:e2e",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@shared/security-headers": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-boundaries": "7.4.1",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
