{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Production only for now (ADR 0007). Local dev uses the same config plus .dev.vars.
  "name": "shared-secure",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Origin isolation: the app is only reachable on its own subdomain, never on *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "shared.arysetyap.com", "custom_domain": true }],
  "assets": {
    "directory": "../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  // Approximate per-location limits (ADR 0006). Keys are HMAC(ip) with a daily-rotating salt.
  "ratelimits": [
    { "name": "RL_READ", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_CREATE", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NOTES_DO", "class_name": "NoteItemDurableObject" },
      { "name": "FILES_DO", "class_name": "FileItemDurableObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NoteItemDurableObject", "FileItemDurableObject"] },
  ],
  "r2_buckets": [{ "binding": "FILES_BUCKET", "bucket_name": "shared-secure-files-prod" }],
  "vars": {
    "ENVIRONMENT": "production",
    "FEATURE_NOTES": "false",
    "FEATURE_FILES": "false",
    "FEATURE_LIVE_NOTES": "false",
    "MAX_JSON_BODY_BYTES": "1048576",
    "MAX_FILE_BYTES_GUEST": "52428800",
    "MAX_FILE_CHUNKS": "200",
    // Padded note plaintext up to 256 KiB + 29 bytes of format overhead (ADR 0011).
    "MAX_NOTE_BYTES": "262173",
    "GUEST_NOTE_TTL_OPTIONS_SECONDS": "300,3600,86400,604800",
    "GUEST_FILE_TTL_OPTIONS_SECONDS": "300,3600,86400",
    "TURNSTILE_EXPECTED_HOSTNAME": "shared.arysetyap.com",
  },
  // Set with `wrangler secret put` (runbook): TURNSTILE_SECRET_KEY, IP_HASH_SECRET,
  // TURNSTILE_SITE_KEY (public, kept out of git so a missing value fails closed), and optionally
  // ADMIN_TOKEN_HASH (SHA-256 of the admin revoke token).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Invocation logs include request URLs; we log route patterns ourselves instead.
    "logs": { "enabled": true, "invocation_logs": false },
  },
}
